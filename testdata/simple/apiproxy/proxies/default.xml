<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ProxyEndpoint name="default">
    <HTTPProxyConnection>
        <BasePath>/api/v1</BasePath>
        <VirtualHost>secure</VirtualHost>
    </HTTPProxyConnection>
    <PreFlow name="PreFlow">
        <Request/>
        <Response/>
    </PreFlow>
    <PostFlow name="PostFlow">
        <Request/>
        <Response/>
    </PostFlow>
    <Flows>
        <Flow name="GetUsers">
            <Condition>(request.verb = "GET") and (proxy.pathsuffix MatchesPath "/users")</Condition>
            <Request>
                <Step>
                    <Name>ExtractAuthToken</Name>
                </Step>
            </Request>
            <Response/>
        </Flow>
        <Flow name="CreateUser">
            <Condition>(request.verb = "POST") and (proxy.pathsuffix = "/users")</Condition>
            <Request/>
            <Response/>
        </Flow>
    </Flows>
</ProxyEndpoint>
