<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ProxyEndpoint name="default">
    <HTTPProxyConnection>
        <BasePath>/test/assign-message-response</BasePath>
    </HTTPProxyConnection>
    <PreFlow name="PreFlow">
        <Request/>
        <Response/>
    </PreFlow>
    <PostFlow name="PostFlow">
        <Request/>
        <Response/>
    </PostFlow>
    <Flows>
        <Flow name="Test">
            <Condition>(request.verb = "GET")</Condition>
            <Request/>
            <Response>
                <Step><Name>SetResponseHeader</Name></Step>
            </Response>
        </Flow>
    </Flows>
</ProxyEndpoint>
