<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ProxyEndpoint name="default">
    <HTTPProxyConnection>
        <BasePath>/test/when</BasePath>
    </HTTPProxyConnection>
    <PreFlow name="PreFlow">
        <Request/>
        <Response/>
    </PreFlow>
    <PostFlow name="PostFlow">
        <Request/>
        <Response/>
    </PostFlow>
    <Flows>
        <Flow name="Test">
            <Condition>(request.verb = "GET")</Condition>
            <Request>
                <Step>
                    <Name>InjectHeader</Name>
                    <Condition>(request.header.X-Trigger = "yes")</Condition>
                </Step>
            </Request>
            <Response/>
        </Flow>
    </Flows>
</ProxyEndpoint>
