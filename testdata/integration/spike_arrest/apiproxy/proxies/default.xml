<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ProxyEndpoint name="default">
    <HTTPProxyConnection>
        <BasePath>/test/spike-arrest</BasePath>
    </HTTPProxyConnection>
    <PreFlow name="PreFlow">
        <Request>
            <Step><Name>RateLimit</Name></Step>
        </Request>
        <Response/>
    </PreFlow>
    <PostFlow name="PostFlow">
        <Request/>
        <Response/>
    </PostFlow>
    <Flows>
        <Flow name="Test">
            <Condition>(request.verb = "GET")</Condition>
            <Request/>
            <Response/>
        </Flow>
    </Flows>
</ProxyEndpoint>
