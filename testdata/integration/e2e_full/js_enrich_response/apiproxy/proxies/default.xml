<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ProxyEndpoint name="default">
    <HTTPProxyConnection>
        <BasePath>/test/js-enrich</BasePath>
    </HTTPProxyConnection>
    <PreFlow name="PreFlow">
        <Request/>
        <Response/>
    </PreFlow>
    <PostFlow name="PostFlow">
        <Request/>
        <Response/>
    </PostFlow>
    <Flows>
        <Flow name="Test">
            <Condition>(request.verb = "GET")</Condition>
            <Request>
                <Step><Name>EnrichRequest</Name></Step>
                <Step><Name>ForwardRequestID</Name></Step>
            </Request>
            <Response/>
        </Flow>
    </Flows>
</ProxyEndpoint>
