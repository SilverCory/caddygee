<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ProxyEndpoint name="default">
    <HTTPProxyConnection>
        <BasePath>/test/conditional-transform</BasePath>
    </HTTPProxyConnection>
    <PreFlow name="PreFlow">
        <Request/>
        <Response/>
    </PreFlow>
    <PostFlow name="PostFlow">
        <Request/>
        <Response/>
    </PostFlow>
    <Flows>
        <Flow name="Test">
            <Condition>(request.verb = "GET")</Condition>
            <Request>
                <Step>
                    <Name>InjectEnv</Name>
                    <Condition>(request.header.X-Tier = "premium")</Condition>
                </Step>
            </Request>
            <Response/>
        </Flow>
    </Flows>
</ProxyEndpoint>
